{
  "agentMode": "accept-edits",
  "toolPermission": "request-review",
  "permissions": {
    "allow": [
      "command(./gradlew)",
      "command(git)",
      "command(gh pr create)",
      "command(gh pr view)",
      "command(gh pr checks)",
      "command(gh pr comment)",
      "command(javap)",
      "command(rg)",
      "command(grep)"
    ],
    "deny": [
      "write_file(gauntlet/)",
      "write_file(.claude/)",
      "write_file(.agents/)",
      "write_file(.gemini/)",
      "write_file(CLAUDE.md)",
      "write_file(GEMINI.md)",
      "write_file(AGENTS.md)",
      "write_file(.github/workflows/gauntlet.yml)",
      "write_file(.github/workflows/gauntlet-kit.yml)",
      "write_file(CODEOWNERS)",
      "write_file(.github/CODEOWNERS)",
      "write_file(.gitlab/CODEOWNERS)",
      "write_file(.git/)",
      "write_file(<HOME>/.gemini/)",
      "write_file(<HOME>/.agents/)",
      "command(gh pr merge)",
      "command(gh workflow disable)",
      "command(git rebase)",
      "command(git filter-branch)",
      "command(git filter-repo)",
      "command(git update-ref)",
      "command(git replace)",
      "command(git revert)",
      "command(git commit --amend)",
      "command(git reset --hard)",
      "command(git push --force)",
      "command(git push -f)",
      "command(git push --force-with-lease)",
      "command(git push --mirror)",
      "command(git push --all)",
      "command(git checkout -B)",
      "command(git switch -C)",
      "command(git branch -f)",
      "command(git branch -D)",
      "command(git branch -M)",
      "command(git commit --am)",
      "command(git push --m)",
      "command(git push --al)",
      "command(git push --b)",
      "command(git branch --forc)",
      "command(git branch --d)",
      "command(git branch --mo)",
      "command(git branch --cop)",
      "command(git switch --force-)"
    ]
  }
}
